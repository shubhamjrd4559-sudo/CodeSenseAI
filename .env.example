# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# AI Provider: xKiro (Recommended)
XKIRO_API_KEY=your-xkiro-api-key-here
XKIRO_MODEL=qwen/qwen3.8-omni-flash:free
XKIRO_BASE_URL=https://api.xkiro.com/v1

# Alternative AI Provider: NVIDIA NIM
NVIDIA_API_KEY=nvapi-your-key-here
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_CHAT_MODEL=meta/llama-3.1-70b-instruct

# RAG
ENABLE_RAG=true

# Limits
MAX_CODE_CHARS=20000
MAX_CHAT_CONTEXT_CHARS=6000
REQUEST_TIMEOUT_SECONDS=60
CHAT_REQUEST_TIMEOUT_SECONDS=45
REVIEW_MAX_TOKENS=1800
CHAT_MAX_TOKENS=700
